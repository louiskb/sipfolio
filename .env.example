# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- App services ---
GITHUB_TOKEN=        # Azure AI inference API key (OpenAI-compatible) for SipSense Mix; app boots without it, AI features won't work
CLOUDINARY_URL=      # cloudinary://<api_key>:<api_secret>@<cloud_name> — Active Storage service in development and production
REDIS_URL=           # Production only (Action Cable). Leave blank locally; development uses the async adapter.

# --- Seeds (db/seeds.rb) — required for `rails db:seed`, otherwise User.create! fails validation ---
USER_PASSWORDS=      # Password shared by the 22 Faker-generated users
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=
USER_1_EMAIL=
USER_1_PASSWORD=
USER_1_USERNAME=
